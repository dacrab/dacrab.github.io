<section
  class="relative flex min-h-screen flex-col justify-center overflow-hidden px-6 pt-32 md:px-12"
  id="hero-section"
>
  <div class="relative z-10 mx-auto w-full max-w-[90vw]">
    <h1 class="hero-title text-[12vw] leading-[0.85] font-bold tracking-tighter text-zinc-900">
      <span class="block overflow-hidden">
      <span class="word inline-block">VAGGELIS</span>
      </span>
      <span class="block overflow-hidden">
        <span class="word crab-trigger inline-block">KAVOURAS</span>
      </span>
    </h1>

    <div class="mt-12 ml-auto flex max-w-4xl flex-col items-start gap-8 md:flex-row md:gap-24">
      <div class="overflow-hidden">
        <p class="hero-text max-w-md text-xl leading-relaxed text-zinc-600 md:text-2xl">
          Full-Stack Web Developer specialized in building high-performance applications with
          Next.js, Astro, and SvelteKit.
        </p>
      </div>

      <a
        href="#projects"
        class="group hero-actions hero-btn relative inline-flex h-12 items-center justify-center overflow-hidden rounded-full bg-zinc-900 px-6 font-medium text-white transition-[background-color] duration-300 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:bg-zinc-800"
      >
        <span>View Projects</span>
        <span
          class="hero-btn-arrow ml-0 w-0 overflow-hidden transition-[width] duration-500 ease-[cubic-bezier(0.215,0.61,0.355,1)] group-hover:w-6"
        >
          <svg class="ml-2" width="16" height="16" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { reveal } from '../lib/reveal';

  const isMobile = window.matchMedia('(hover: none)').matches;

  const wordSet = { y: '100%', autoAlpha: 0 };
  const textSet = { autoAlpha: 0, y: 32 };

  if (isMobile) {
    reveal(
      [
        {
          targets: '.hero-title .word',
          set: wordSet,
          to: { y: 0, autoAlpha: 1, duration: 0.5 },
        },
        {
          targets: ['.hero-text', '.hero-actions'],
          set: textSet,
          to: { autoAlpha: 1, y: 0, duration: 0.4 },
          at: '-=0.2',
        },
      ],
      { delay: 0.1 },
    );
  } else {
    reveal(
      [
        {
          targets: '.hero-title .word',
          set: wordSet,
          to: { y: 0, autoAlpha: 1, duration: 1.5, stagger: 0.1, ease: 'power4.out' },
        },
        { targets: '.hero-text', set: textSet, to: { autoAlpha: 1, y: 0, duration: 1.2 }, at: '-=1.0' },
        { targets: '.hero-actions', set: textSet, to: { autoAlpha: 1, y: 0, duration: 1.2 }, at: '-=1.0' },
      ],
      { delay: 0.3, defaults: { ease: 'expo.out' } },
    );

    // Parallax: the title drifts down as the hero scrolls away.
    gsap.to('.hero-title', {
      y: 80,
      ease: 'none',
      scrollTrigger: { trigger: '#hero-section', start: 'top top', end: 'bottom top', scrub: 1.5 },
    });
  }
</script>
