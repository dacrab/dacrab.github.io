---
import { site } from '../data/site';

const links = [
  { label: 'Work', href: '#projects' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="fixed top-0 right-0 left-0 z-50 text-white mix-blend-difference">
  <div class="flex items-center justify-between px-6 py-8 md:px-12">
    <a
      href="#hero-section"
      aria-label={`${site.name} — back to top`}
      class="header-reveal inline-block text-sm font-bold tracking-widest uppercase"
    >
      {site.name}
    </a>

    <button
      id="menu-toggle"
      class="header-reveal relative z-50 flex h-8 w-12 cursor-pointer flex-col items-end justify-center gap-1.5 mix-blend-difference"
      aria-label="Toggle Menu"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      <span id="bar-top" class="h-[2px] w-full bg-white"></span>
      <span id="bar-bottom" class="h-[2px] w-3/4 bg-white"></span>
    </button>
  </div>
</header>

<div
  id="menu-overlay"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center bg-zinc-950 text-white"
  style="transform: translateX(100%)"
  aria-hidden="true"
  inert
>
  <nav>
    <ul class="flex flex-col items-center gap-8">
      {
        links.map((link) => (
          <li class="menu-item">
            <a
              href={link.href}
              class="inline-block text-4xl font-bold tracking-tighter uppercase md:text-6xl"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="menu-item">
        <div class="mt-8 flex flex-col items-center gap-4">
          <span class="text-sm font-medium tracking-widest text-zinc-500 uppercase">Resume</span>
          <div class="flex gap-4">
            <a
              href={site.cv.en}
              target="_blank"
              rel="noopener noreferrer"
              class="relative inline-block text-sm font-bold tracking-widest uppercase"
            >
              EN
            </a>
            <span class="text-zinc-600">/</span>
            <a
              href={site.cv.gr}
              target="_blank"
              rel="noopener noreferrer"
              class="relative inline-block text-sm font-bold tracking-widest uppercase"
            >
              GR
            </a>
          </div>
        </div>
      </li>
    </ul>
  </nav>
</div>

<script>
  import gsap from 'gsap';
  import { reveal } from '../lib/reveal';
  import { getLenis } from '../lib/scroll';

  const menuToggle = document.getElementById('menu-toggle');
  const menuOverlay = document.getElementById('menu-overlay');
  const menuItems = document.querySelectorAll('.menu-item');
  const topBar = document.getElementById('bar-top');
  const bottomBar = document.getElementById('bar-bottom');

  if (!menuToggle || !menuOverlay || !topBar || !bottomBar) {
    throw new Error('Menu markup is missing');
  }

  let isMenuOpen = false;

  gsap.set('.menu-item', { y: 20, opacity: 0 });
  gsap.set(menuOverlay, { x: 0, xPercent: 100 });

  reveal(
    [
      {
        targets: '.header-reveal',
        set: { y: -40, autoAlpha: 0 },
        to: { y: 0, autoAlpha: 1, duration: 1.2, stagger: 0.15, ease: 'expo.out' },
      },
    ],
    { delay: 0.3 },
  );

  const setMenuState = (open: boolean) => {
    isMenuOpen = open;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuOverlay.toggleAttribute('inert', !open);
    menuOverlay.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) getLenis().stop();
    else getLenis().start();
  };

  const openMenu = () => {
    setMenuState(true);
    gsap.to(menuOverlay, { xPercent: 0, duration: 0.8, ease: 'expo.inOut' });
    gsap.to(menuItems, { y: 0, opacity: 1, duration: 1, stagger: 0.1, delay: 0.4, ease: 'expo.out' });
    gsap.to(topBar, { rotate: 45, y: 4, width: '100%', duration: 0.4, ease: 'expo.out' });
    gsap.to(bottomBar, { rotate: -45, y: -4, width: '100%', duration: 0.4, ease: 'expo.out' });
    menuOverlay.querySelector('a')?.focus({ preventScroll: true });
  };

  const closeMenu = (restoreFocus = true) => {
    setMenuState(false);
    gsap.to(menuOverlay, { xPercent: 100, duration: 0.8, ease: 'expo.inOut' });
    gsap.to(menuItems, { y: 20, opacity: 0, duration: 0.4, ease: 'expo.out' });
    gsap.to(topBar, { rotate: 0, y: 0, width: '100%', duration: 0.4, ease: 'expo.out' });
    gsap.to(bottomBar, { rotate: 0, y: 0, width: '75%', duration: 0.4, ease: 'expo.out' });
    if (restoreFocus) menuToggle.focus({ preventScroll: true });
  };

  menuToggle.addEventListener('mouseenter', () => {
    if (!isMenuOpen) {
      gsap.to(topBar, { width: '75%', duration: 0.3 });
      gsap.to(bottomBar, { width: '100%', duration: 0.3 });
    }
  });

  menuToggle.addEventListener('mouseleave', () => {
    if (!isMenuOpen) {
      gsap.to(topBar, { width: '100%', duration: 0.3 });
      gsap.to(bottomBar, { width: '75%', duration: 0.3 });
    }
  });

  menuToggle.addEventListener('click', () => {
    if (isMenuOpen) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen) closeMenu();
  });

  for (const item of menuItems) {
    item.addEventListener('click', () => {
      // Close after the anchor's default navigation so inert doesn't interfere with it.
      if (isMenuOpen) requestAnimationFrame(() => closeMenu(false));
    });
  }
</script>
