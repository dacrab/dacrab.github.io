---
import { site } from '../data/site';

const year = new Date().getFullYear();

const socials = [
  { label: 'GITHUB', href: site.socials.github },
  { label: 'LINKEDIN', href: site.socials.linkedin },
  { label: 'EMAIL', href: `mailto:${site.email}` },
] as const;
---

<footer class="footer-section overflow-hidden border-t border-white/10 bg-zinc-950 px-6 pt-20 pb-8 md:px-12">
  <div class="mx-auto max-w-[90vw]">
    <!-- Giant ghost text with stroke effect -->
    <p aria-hidden="true" class="footer-name crab-trigger pointer-events-auto mb-12 text-center text-[16vw] leading-none font-black tracking-tighter text-transparent select-none [-webkit-text-stroke:2px_rgba(255,255,255,0.12)] md:text-left">
      KAVOURAS
    </p>

    <!-- Bottom bar -->
    <div class="flex flex-col items-center justify-between gap-6 border-t border-white/5 pt-8 md:flex-row">
      <div class="flex gap-6 font-mono text-sm text-zinc-600">
        {socials.map(({ label, href }) => (
          <a
            href={href}
            target={href.startsWith('mailto') ? undefined : '_blank'}
            rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
            class="transition-colors hover:text-white"
          >{label}</a>
        ))}
      </div>

      <p class="text-xs tracking-widest text-zinc-600 uppercase">
        &copy; {year} {site.name}
      </p>
    </div>
  </div>
</footer>

<script>
  import { reveal } from '../lib/reveal';

  reveal(
    [
      {
        targets: '.footer-name',
        set: { opacity: 0, y: 60 },
        to: { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' },
      },
    ],
    { scrollTrigger: { trigger: '.footer-section', start: 'top 85%' } },
  );
</script>
