---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Full-Stack Web Developer specialized in Next.js, Astro, and SvelteKit. Building high-performance, accessible web applications with a focus on engineering precision.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  sameAs: [site.socials.github, site.socials.linkedin],
  knowsAbout: [
    'Next.js',
    'Astro',
    'SvelteKit',
    'TypeScript',
    'Tailwind CSS',
    'Go',
    'PostgreSQL',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <title>{title}</title>

    <noscript>
      <style is:inline>
        .header-reveal,
        .hero-title .word,
        .hero-text,
        .hero-actions {
          visibility: visible !important;
        }
      </style>
    </noscript>
  </head>
  <body
    class="bg-zinc-50 font-sans text-zinc-900 antialiased selection:bg-black selection:text-white"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-medium focus:text-zinc-900"
    >
      Skip to content
    </a>
    <div class="grain-overlay pointer-events-none fixed inset-0 z-[90] opacity-[0.03] mix-blend-overlay"></div>
    <div id="crab-cursor" class="crab-cursor" aria-hidden="true">🦀</div>

    <script>
      import gsap from 'gsap';
      import { getLenis } from '../lib/scroll';

      getLenis();

      // Crab cursor on KAVOURAS text
      const crab = document.getElementById('crab-cursor');
      if (crab && !window.matchMedia('(hover: none)').matches) {
        let onCrab = false;

        for (const el of document.querySelectorAll<HTMLElement>('.crab-trigger')) {
          el.addEventListener('mouseenter', () => {
            onCrab = true;
            document.body.style.cursor = 'none';
            gsap.to(crab, { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(2)' });
          });
          el.addEventListener('mouseleave', () => {
            onCrab = false;
            document.body.style.cursor = '';
            gsap.to(crab, { opacity: 0, scale: 0.5, duration: 0.2, ease: 'power2.in' });
          });
          el.addEventListener('mousemove', (event) => {
            if (onCrab) gsap.set(crab, { left: event.clientX, top: event.clientY });
          });
        }
      }
    </script>
    <slot />
  </body>
</html>

<style>
  .crab-cursor {
    position: fixed;
    z-index: 100;
    pointer-events: none;
    font-size: 2.25rem;
    line-height: 1;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }

  .grain-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    animation: grain 8s steps(10) infinite;
  }

  @keyframes grain {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-5%, -10%); }
    20% { transform: translate(-15%, 5%); }
    30% { transform: translate(7%, -25%); }
    40% { transform: translate(-5%, 25%); }
    50% { transform: translate(-15%, 10%); }
    60% { transform: translate(15%, 0%); }
    70% { transform: translate(0%, 15%); }
    80% { transform: translate(3%, 35%); }
    90% { transform: translate(-10%, 10%); }
  }
</style>
